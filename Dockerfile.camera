FROM python:3.11-slim

# Install system dependencies for OpenCV and camera access
RUN apt-get update && apt-get install -y \
    libopencv-dev \
    python3-opencv \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgtk-3-0 \
    libavcodec-dev \
    libavformat-dev \
    libswscale-dev \
    libv4l-dev \
    && rm -rf /var/lib/apt/lists/*

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OPENCV_VIDEOIO_PRIORITY_V4L2=1

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Install additional requirements for camera agent
RUN pip install --no-cache-dir \
    opencv-python-headless==4.8.* \
    PyYAML==6.0.* \
    python-dotenv==1.0.* \
    requests==2.31.* \
    plyer==2.1.*

# Copy camera agent files
COPY camera_agent.py ./
COPY camera_config.yaml ./

# Create directories for logs and detected images
RUN mkdir -p /app/detected_images /app/logs

# Create non-root user for security
RUN groupadd -r camera && useradd -r -g camera camera
RUN chown -R camera:camera /app

# Switch to non-root user
USER camera

# Health check
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD python3 -c "import sys; sys.exit(0)" || exit 1

# Set default environment variables
ENV OLLAMA_URL=http://ollama:11434 \
    VISION_MODEL=llava:7b \
    CAMERA_INDEX=0 \
    CAPTURE_INTERVAL=5 \
    LOG_LEVEL=INFO

# Run the camera agent
CMD ["python3", "camera_agent.py", "--config", "camera_config.yaml"]