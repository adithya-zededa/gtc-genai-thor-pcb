[Unit]
Description=ZEDEDA Camera Monitor Detection Agent
Documentation=https://github.com/zededa/vision-ai
After=network.target
Wants=network.target

[Service]
Type=simple
User=nvidia
Group=nvidia
WorkingDirectory=/home/nvidia/Developer/agent-attempt-2
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# Environment variables for the camera agent
Environment="OLLAMA_URL=http://localhost:11434"
Environment="VISION_MODEL=llava:7b"
Environment="CAMERA_INDEX=0"
Environment="CAPTURE_INTERVAL=5"
Environment="LOG_LEVEL=INFO"

# Load additional environment variables from .env file
EnvironmentFile=-/home/nvidia/Developer/agent-attempt-2/.env

# Main command
ExecStart=/usr/bin/python3 /home/nvidia/Developer/agent-attempt-2/camera_agent.py --config /home/nvidia/Developer/agent-attempt-2/camera_config.yaml

# Restart policy
Restart=on-failure
RestartSec=10
StartLimitBurst=5
StartLimitIntervalSec=300

# Output handling
StandardOutput=journal
StandardError=journal
SyslogIdentifier=zededa-camera-agent

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/home/nvidia/Developer/agent-attempt-2

# Allow access to video devices
SupplementaryGroups=video

[Install]
WantedBy=multi-user.target